# ────────────────────────────────────────────────────────────
# Daily Tracker — variables d'environnement
# En local : copiez ce fichier en .env.local
# Sur Vercel : Project › Settings › Environment Variables
# ────────────────────────────────────────────────────────────

# URL publique canonique (SANS slash final). Indispensable en production :
# elle sert à construire les redirect_uri OAuth déclarées chez Google et Atlassian.
APP_URL=https://votre-app.vercel.app

# Secret de signature des sessions (32 caractères minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ──
# URI de redirection autorisées à déclarer (exactement) :
#   https://votre-app.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel : restreindre l'accès (e-mails séparés par des virgules) et limiter le nombre de comptes
ALLOWED_EMAILS=
MAX_USERS=10

# ── Supabase (Project Settings › API) ──
# Le schéma est dans supabase/schema.sql (à exécuter dans le SQL Editor)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Jira OAuth 2.0 3LO (https://developer.atlassian.com/console/myapps/) ──
# Callback URL : https://votre-app.vercel.app/api/auth/jira/callback
# Scopes : read:jira-user read:jira-work write:jira-work offline_access read:account
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ── Rappels push (optionnel) ──
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com
# Protège /api/cron/reminder (Vercel l'envoie automatiquement aux crons)
CRON_SECRET=
